FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

defaultFieldValues
(
    volScalarFieldValue alpha.water 1
);

regions
(
	
	cylinderToCell
    {
        p1 (0 0 0);  // Start point of the cylinder axis
        p2 (0.016 0 0);   // End point of the cylinder axis
        radius 0.0019;          // Radius of the cylinder
        fieldValues
        (
            volScalarFieldValue alpha.water 0
        );
    }
	
	sphereToCell
    {
        centre (0.016 0.000 0);  // Start point of the cylinder axis
        radius 0.0019;          // Radius of the cylinder
        fieldValues
        (
            volScalarFieldValue alpha.water 0
        );
    }
	
	cylinderToCell
    {
        p1 (0.0218 0.000 0);  // Start point of the cylinder axis
        p2 (0.0378 0.000 0.0);   // End point of the cylinder axis
        radius 0.0019;          // Radius of the cylinder
        fieldValues
        (
            volScalarFieldValue alpha.water 0
        );
    }
	
	sphereToCell
    {
        centre (0.0218 0.000 0);;  // Start point of the cylinder axis
        radius 0.0019;          // Radius of the cylinder
        fieldValues
        (
            volScalarFieldValue alpha.water 0
        );
    }
	
);


